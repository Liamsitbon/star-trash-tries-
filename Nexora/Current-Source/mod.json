    },
    {
      "version": "^0.24.5",
      "id": "custom-json-data",
      "downloadIfMissing": "https://github.com/bsq-ports/CustomJSONData/releases/download/v0.24.5/custom-json-data.qmod"
    },
    {
      "version": "^1.1.26",
      "id": "songcore",
      "downloadIfMissing": "https://github.com/raineaeternal/Quest-SongCore/releases/download/v1.1.26/SongCore.qmod"
    },
    {
      "version": "^4.8.0",
      "id": "paper2_scotland2",
      "downloadIfMissing": "https://github.com/Fernthedev/paperlog/releases/download/v4.8.0/paper2_scotland2.qmod"
    }
  ],
  "modFiles": [],
